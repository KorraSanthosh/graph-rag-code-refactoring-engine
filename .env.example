# Environment variables — copy this to .env and fill in your values
# NEVER commit .env to git

# ─── Required ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── LLM ───────────────────────────────────────────────────────────────────────
# Defaults target OpenAI. For Google Gemini (OpenAI-compatible endpoint), put the Gemini key
# in OPENAI_API_KEY and uncomment:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.8-flash
#   EMBEDDING_MODEL=gemini-embedding-001
#   LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.2
# Comma-separated models tried in order if the main one is overloaded (429/5xx).
LLM_FALLBACK_MODELS=

# ─── Sandbox ───────────────────────────────────────────────────────────────────
# What to do when Docker is not reachable: "subprocess" (dev only, weak isolation)
# or "disabled" (refuse to execute generated code — use this in production).
SANDBOX_FALLBACK=subprocess

# ─── Public deployment protection (all optional) ───────────────────────────────
# If set, POST requests must send header `X-Access-Key: <value>` (UI: click the 🔑 button).
ACCESS_KEY=
# Max /refactor calls per client IP per minute (0 disables). Protects your OpenAI bill.
RATE_LIMIT_PER_MIN=10
# Comma-separated allowed origins for CORS ("*" = any).
CORS_ORIGINS=*
